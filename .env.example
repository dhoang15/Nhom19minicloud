# File mẫu biến môi trường cho MyMiniCloud.
# Sao chép thành .env và thay mọi giá trị CHANGE_ME trước khi chạy.
# Không commit .env hoặc dùng các giá trị ví dụ trên môi trường public.

# --- Image ---
DOCKERHUB_USERNAME=nhom19minicloud
IMAGE_TAG=dev

# --- Cổng host (các cổng quản trị chỉ bind vào localhost) ---
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=80
WEB1_PORT=18080
WEB2_PORT=18082
APP_PORT=18085
KEYCLOAK_PORT=18081
KEYCLOAK_HOSTNAME_URL=http://localhost:18081
DB_PORT=13306
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
DNS_PORT=1053
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# --- Database ---
MARIADB_ROOT_PASSWORD=CHANGE_ME_DB_ROOT_PASSWORD

# --- Keycloak ---
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_KC_ADMIN_PASSWORD
SV01_PASSWORD=CHANGE_ME_SV01_PASSWORD
SV02_PASSWORD=CHANGE_ME_SV02_PASSWORD
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_PASSWORD

# --- MinIO ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_PASSWORD
