# File mẫu biến môi trường cho MyMiniCloud.
# Sao chép thành .env và điền các giá trị bắt buộc đang để trống trước khi chạy.
# Chỉ commit file mẫu này; không commit .env.

# --- Image ---
# Use the Docker Hub username or organization namespace where you have write access.
DOCKERHUB_USERNAME=
IMAGE_TAG=dev

# --- Cổng host ---
# Local defaults. For EC2, set GATEWAY_BIND=0.0.0.0 and only expose the gateway.
GATEWAY_BIND=127.0.0.1
GATEWAY_PORT=80
WEB1_PORT=18080
WEB2_PORT=18082
APP_PORT=18085
KEYCLOAK_PORT=18081
# Local-only default; use a public hostname and configure Keycloak redirects for EC2.
KEYCLOAK_HOSTNAME_URL=http://localhost:18081
DB_PORT=13306
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
DNS_PORT=1053
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000

# --- Database ---
MARIADB_ROOT_PASSWORD=

# --- Keycloak ---
KC_BOOTSTRAP_ADMIN_USERNAME=
KC_BOOTSTRAP_ADMIN_PASSWORD=
SV01_PASSWORD=
SV02_PASSWORD=
GRAFANA_ADMIN_PASSWORD=

# --- MinIO ---
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
