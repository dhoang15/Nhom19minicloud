# File mẫu biến môi trường cho hệ thống MyMiniCloud - Nhóm 19
# Sao chép file này thành .env trước khi chạy: cp .env.example .env
# KHÔNG commit file .env chứa mật khẩu thật lên Git repository.

# --- Cấu hình Docker Hub / Image Tag ---
DOCKERHUB_USERNAME=nhom19minicloud
WEB_IMAGE_TAG=dev

# --- Cấu hình Cổng (Ports) ---
WEB1_PORT=8080
WEB2_PORT=8082
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# --- Cấu hình Object Storage (MinIO) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# --- Cấu hình Database (MariaDB - dành cho thành viên phụ trách DB) ---
MARIADB_ROOT_PASSWORD=CHANGE_ME_DB_ROOT_PASSWORD
MARIADB_DATABASE=minicloud

# --- Cấu hình Keycloak (Auth - dành cho thành viên phụ trách Auth) ---
KC_BOOTSTRAP_ADMIN_USERNAME=CHANGE_ME_KC_ADMIN_USER
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_KC_ADMIN_PASSWORD
